{
  "name": "cinema-hall-api",
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "npx nodemon server.js",
    "dev:all": "concurrently -n API,QSTASH -c blue,green \"npx nodemon server.js\" \"npx @upstash/qstash-cli@latest dev\"",
    "start": "node --import=@sentry/node/preload server.js",
    "migrate:backdrops": "node migrate-backdrop.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "@sentry/node": "^10.47.0",
    "@upstash/qstash": "^2.11.3",
    "bcrypt": "^6.0.0",
    "chalk": "^5.4.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "firebase-admin": "^14.3.0",
    "google-auth-library": "^10.7.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.10",
    "pg": "^8.16.2",
    "postgres": "^3.4.7",
    "razorpay": "^2.9.6",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^10.0.5",
    "supertest": "^7.2.2",
    "vitest": "^4.1.8"
  }
}
