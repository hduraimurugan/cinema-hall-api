{
  "version": 2,
  "env": {
    "NODE_OPTIONS": "--import=@sentry/node/preload"
  },
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/jobs",
      "schedule": "0 0 * * *"
    }
  ]
}
